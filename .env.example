# DataMentor AI Environment Variables

PROJECT_NAME=DataMentor AI
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Frontend URL for CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Backend Server Config
HOST=0.0.0.0
PORT=8000

# RAG & LLM Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-flash-latest-lite
EMBEDDING_PROVIDER=local

